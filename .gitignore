# Build output. The binary is 13 MB and is rebuilt from `release/Dockerfile`; what a
# reviewer needs is the source it was built from, and what a user needs is the npm
# tarball, which carries it.
bin/
dist/
node_modules/
toolbar/src-tauri/target/

# Where `clawhub package pack` puts the tarball it uploads. It is the build output
# again, 5 MB of it, and committing one would put a stale copy of the plugin in the
# repository people read to check what the plugin is.
.pack/

# Build output: `scripts/build-sidecar.mjs` produces this from `agent/sidecar.mjs`.
agent/sidecar.bundle.mjs
