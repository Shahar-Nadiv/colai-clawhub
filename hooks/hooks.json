{
  "description": "Say that colai is here, hand over anything it left for this conversation, and deliver marks into the session as they arrive.",
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "sh \"${CLAUDE_PLUGIN_ROOT}/hooks/say-colai-is-here.sh\"",
            "timeout": 5
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "sh \"${CLAUDE_PLUGIN_ROOT}/hooks/take-what-colai-staged.sh\"",
            "timeout": 10
          }
        ]
      }
    ]
  },
  "modules": [
    "./bridge.ts"
  ]
}
