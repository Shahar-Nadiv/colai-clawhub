{
  "description": "Say that colai is here, and hand over anything it left for this conversation.",
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "sh \"${CLAUDE_PLUGIN_ROOT}/hooks/say-colai-is-here.sh\"",
            "timeout": 5
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "sh \"${CLAUDE_PLUGIN_ROOT}/hooks/take-what-colai-staged.sh\"",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
